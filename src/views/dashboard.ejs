<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>dadosa</title>

    <link rel="stylesheet" href="/css/variables.css" />
    <link rel="stylesheet" href="/css/base.css" />
    <link rel="stylesheet" href="/css/dashboard.css" />
  </head>

  <body>
    <div class="app">
      <header class="header">
        <div class="header-left">
          <button class="header-fullscreen">
            <img src="/img/fullscreen.png" alt="Tela Cheia" />
          </button>
        </div>

        <div class="header-right">
          <button class="header-profile">
            <img src="/img/profile.png" alt="Ícone de Perfi" />
          </button>
        </div>
      </header>

      <main class="dashboard">
        <section class="device-header">
          <button class="device-selector">
            <img src="/img/menu.png" alt="Menu de Dispositivos" />
          </button>

          <div class="device-info">
            <% if(response == "erro") {%>
                <strong>
                  <%= error %>
                </strong>
              <%}else{%>
                <h1><%= dados.nome %></h1>
                <%} %>
            <% if(response == "erro"){%>
              <span class="status status--connected"> ● Não conectado </span>    
            <%}else{%>
              <span class="status status--connected"> ● Conectado </span>           
            <%} %>
          </div>
        </section>

        <section class="dashboard-grid">
          <div class="dashboard-left">
            <article class="metric-card">
              <span class="metric-card-label"> Temperatura </span>
              <% if(response == "erro") {%>
                <strong>
                  <%= error %>
                </strong>
              <%}else{%>
                <strong class="metric-card-value">
                  <%= dados.temperatura %>°C
                </strong>  
                <%} %>

              <span class="status status--normal"> ● Normal </span>
              <% if(response == "erro") {%>
                <strong>
                  <%= error %>
                </strong>
              <%}else{%>
              <small class="metric-card-update">
                Atualizado há <%= dados.tempo %> segundos
              </small>
              <%} %>
            </article>

            <article class="metric-card">
              <span class="metric-card-label"> Umidade </span>
              <% if(response == "erro") {%>
                <strong>
                  <%= error %>
                </strong>
              <%}else{%>
              <strong class="metric-card-value">
                <%= dados.umidade %>%
              </strong>
              <%} %>
              <span class="status status--warning"> ● Alerta </span>
              <% if(response == "erro") {%>
                <strong>
                  <%= error %>
                </strong>
              <%}else{%>
              <small class="metric-card-update">
                Atualizado há <%= dados.tempo %> segundos
              </small>
              <%} %>
            </article>
          </div>

          <div class="dashboard-right">
            <article class="graph-card">
              <span class="graph-title"> Gráfico de Temperatura — 24h </span>

              <div class="graph-placeholder">Gráfico</div>
              <script>
  // Renderiza o gráfico estático com os dados carregados pelo GET /
  const historico = <%- JSON.stringify(historico || []) %>;

  const ctx = document.getElementById('graficoSensor').getContext('2d');
  new Chart(ctx, {
    type: 'line',
    data: {
      labels: historico.map(item =>
        new Date(item.createdAt).toLocaleTimeString('pt-BR', { hour: '2-digit', minute: '2-digit', second: '2-digit' })
      ),
      datasets: [
        {
          label: 'Temperatura (°C)',
          data: historico.map(item => item.temperatura),
          borderColor: '#ff4d4d',
          backgroundColor: 'rgba(255, 77, 77, 0.1)',
          tension: 0.3
        },
        {
          label: 'Umidade (%)',
          data: historico.map(item => item.umidade),
          borderColor: '#0066cc',
          backgroundColor: 'rgba(0, 102, 204, 0.1)',
          tension: 0.3
        }
      ]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false
    }
  });

  // Dispara a rota POST / a cada 5 segundos em segundo plano sem recarregar a página
  setInterval(() => {
    fetch('/', { method: 'POST' }).catch(err => console.error('Falha ao salvar:', err));
  }, 5000);
</script>
              <% if(response == "erro") {%>
                <strong>
                  <%= error %>
                </strong>
              <%}else{%>
              <span class="graph-update">
                Atualizado há <%= dados.tempo %> segundos
              </span>
              <%} %>
            </article>
          </div>
        </section>
      </main>

      <footer class="footer">
        <div class="footer-logo-container">
          <!-- <img
            src="/img/dados – Logo.jpg"
            alt="Logo do dadosa"
            class="footer-logo"
          /> -->
        </div>
      </footer>
    </div>
  </body>
</html>
